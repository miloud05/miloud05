diff --git a/src/lib/calc/paste.ts b/src/lib/calc/paste.ts
--- a/src/lib/calc/paste.ts
+++ b/src/lib/calc/paste.ts
@@ -5,7 +5,12 @@

 /** Convertit un nombre saisi à la française (« 1 250,50 ») ou à l'anglaise. */
 export function parseNumber(s: string | undefined): number {
-  const v = Number(String(s ?? "").replace(/[\s\u00a0\u202f]/g, "").replace(",", "."));
+  const compact = String(s ?? "").replace(/[\s\u00a0\u202f]/g, "");
+  // Le point décimal distingue les milliers anglais de la virgule décimale française.
+  const normalized = /^[+-]?\d{1,3}(?:,\d{3})+\.\d+$/.test(compact)
+    ? compact.replace(/,/g, "")
+    : compact.replace(",", ".");
+  const v = Number(normalized);
   return Number.isFinite(v) ? v : 0;
 }

