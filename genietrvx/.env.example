# Copier en .env.local puis adapter.

# Emplacement de la base SQLite (par défaut : ./data/genietrvx.db)
DATABASE_PATH=./data/genietrvx.db

# Clé de signature des sessions (32 caractères minimum).
# Si absente, une clé aléatoire est générée et conservée dans data/.auth-secret
AUTH_SECRET=

# Compte administrateur créé au premier démarrage (changez le mot de passe !)
ADMIN_EMAIL=admin@genietrvx.dz
ADMIN_PASSWORD=Demo@2026

# "false" pour démarrer avec une base vide (sans données de démonstration)
GENIETRVX_DEMO=true

# "true" (au moment du build) pour autoriser l'affichage dans une iframe en production
ALLOW_IFRAME=false
